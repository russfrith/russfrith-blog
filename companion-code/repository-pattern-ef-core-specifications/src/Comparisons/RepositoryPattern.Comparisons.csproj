<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>RepositoryPattern.Comparisons</RootNamespace>
  </PropertyGroup>

  <!--
    This project is deliberately exempt from the architecture rule that forbids
    referencing DbContext / Microsoft.EntityFrameworkCore outside Infrastructure.
    Options 1-4 below exist specifically to show what the alternatives to the
    constrained hybrid (option 5) look like, including the ones that use
    DbContext directly. See ArchitectureTests for the exemption and FINDINGS.md
    for why.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.4" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.1" />
    <PackageReference Include="EFCore.NamingConventions" Version="10.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Domain\RepositoryPattern.Domain.csproj" />
    <ProjectReference Include="..\Application\RepositoryPattern.Application.csproj" />
    <ProjectReference Include="..\Infrastructure\RepositoryPattern.Infrastructure.csproj" />
  </ItemGroup>

</Project>
