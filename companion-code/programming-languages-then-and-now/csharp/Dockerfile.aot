FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY wordfreq.csproj Program.cs ./
RUN apt-get update && apt-get install -y --no-install-recommends clang zlib1g-dev && apt-get clean
RUN dotnet publish -c Release -r linux-x64 -p:PublishAot=true -o /app

FROM mcr.microsoft.com/dotnet/runtime-deps:10.0
WORKDIR /app
COPY --from=build /app .
ENTRYPOINT ["/app/wordfreq"]
